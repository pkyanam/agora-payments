    "/payments/{id}/reconcile": {
      "post": {
        "operationId": "paymentsReconcile",
        "summary": "Reconcile a payment from its stored Stripe Checkout session",
        "description": "Requires payments:write. Fetches only the Checkout session stored for this tenant and validates mode, amount, currency, session ID and metadata before updating state. The request body cannot select a tenant, account, or session.",
        "parameters": [
          {
            "in": "path",
            "name": "id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Current payment status and whether this call applied a reconciliation",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": [
                    "id",
                    "status",
                    "reconciled"
                  ],
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "status": {
                      "type": "string",
                      "enum": [
                        "pending",
                        "succeeded",
                        "failed"
                      ]
                    },
                    "reconciled": {
                      "type": "boolean"
                    }
                  }
                }
              }
            }
          },
          "401": {
            "description": "Invalid or revoked key",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Permission or key-mode denied",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Payment not found in this workspace",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Provider data does not match the stored payment",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Scoped merchant API key. The server pins the key to its merchant and provider mode; never send keys from browser code."
      }
    },
    "schemas": {
      "Product": {
        "type": "object",
        "required": [
          "id",
          "name",
          "amount",
          "currency"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000,
            "description": "USD cents"
          },
          "currency": {
            "const": "usd"
          },
          "created_at": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "Payment": {
        "type": "object",
        "required": [
          "id",
          "amount",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "product_id": {
            "type": "string"
          },
          "product_name": {
            "type": "string"
          },
          "customer": {
            "type": "string"
          },
          "amount": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000000,
            "description": "USD cents"
          },
          "currency": {
            "const": "usd"
          },
          "refunded": {
            "type": "integer",
            "minimum": 0
          },
          "status": {
