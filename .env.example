# Default: .data/agora.sqlite, ignored by git.
# AGORA_DATABASE_PATH=/absolute/path/agora.sqlite
# AGORA_SEED=false
# Optional headless administrative API access outside development. At least 32 chars.
# AGORA_ADMIN_TOKEN=
# Owner dashboard login; at least 24 characters. Used with the signed session cookie.
# AGORA_ADMIN_PASSWORD=
# AGORA_OWNER_EMAIL=info@belweave.com
# Payment provider is sandbox by default. Stripe test/live mode is explicit and mode-matched.
# AGORA_PAYMENT_PROVIDER=sandbox
# AGORA_STRIPE_MODE=test
# Set separate provider keys in the hosting secret manager; never commit them.
# STRIPE_TEST_SECRET_KEY=
# STRIPE_LIVE_SECRET_KEY=
# STRIPE_TEST_WEBHOOK_SECRET=
# STRIPE_LIVE_WEBHOOK_SECRET=
# STRIPE_TEST_CONNECT_CLIENT_ID=ca_...
# STRIPE_LIVE_CONNECT_CLIENT_ID=ca_...
# Required canonical public origin for auth and hosted Checkout return URLs.
# AGORA_PUBLIC_ORIGIN=https://agora.example
