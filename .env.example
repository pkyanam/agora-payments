# Default: .data/agora.sqlite, ignored by git.
# AGORA_DATABASE_PATH=/absolute/path/agora.sqlite
# AGORA_SEED=false
# Optional headless administrative API access outside development. At least 32 chars.
# AGORA_ADMIN_TOKEN=
# Owner dashboard login; at least 24 characters. Used with the signed session cookie.
# AGORA_ADMIN_PASSWORD=
# Payment provider is sandbox by default. Stripe support will require test/live config.
# AGORA_PAYMENT_PROVIDER=sandbox
