# Default local database: .data/agora.sqlite, ignored by git.
# AGORA_DATABASE_PATH=/absolute/path/agora.sqlite
# Deployment metadata is safe to expose through /api/health.
# AGORA_DEPLOYMENT_TYPE=community
# AGORA_DEPLOYMENT_TARGET=node
# AGORA_VERSION=0.0.1
# AGORA_WORKSPACE_NAME=Agora workspace
# AGORA_SEED=false
# Owner dashboard login; generate a long random value. Used with the signed session cookie.
# AGORA_ADMIN_PASSWORD=
# AGORA_ADMIN_TOKEN=
# Stable encryption key for Stripe config saved in the local DB or Cloudflare Durable Object.
# Generate 32 random bytes and base64-encode them. Keep this key across updates and backups.
# AGORA_SECRETS_ENCRYPTION_KEY=
# MFA secret encryption key, separate from the API token.
# AGORA_MFA_ENCRYPTION_KEY=
# Community starts in Stripe test mode. Add test credentials and verify a signed webhook in Settings.
# AGORA_PAYMENT_PROVIDER=stripe
# AGORA_STRIPE_MODE=test
# Set separate provider keys in the hosting secret manager; never commit them.
# STRIPE_TEST_SECRET_KEY=
# STRIPE_LIVE_SECRET_KEY=
# STRIPE_TEST_WEBHOOK_SECRET=
# STRIPE_LIVE_WEBHOOK_SECRET=
# STRIPE_TEST_CONNECT_CLIENT_ID=ca_...
# STRIPE_LIVE_CONNECT_CLIENT_ID=ca_...
# Required public origin for auth and hosted Checkout return URLs.
# AGORA_PUBLIC_ORIGIN=https://agora.example
